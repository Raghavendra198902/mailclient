# Backend environment variables
DATABASE_URL=postgresql://gmail_user:gmail_pass@localhost:5432/gmail_ai
REDIS_URL=redis://localhost:6379
VECTOR_DB_PATH=./data/faiss_index

# Email Provider Credentials

# Gmail OAuth
GMAIL_CLIENT_ID=your_client_id_here
GMAIL_CLIENT_SECRET=your_client_secret_here
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Outlook/Microsoft OAuth
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
OUTLOOK_REDIRECT_URI=http://localhost:8000/auth/outlook/callback

# IMAP/SMTP (for Yahoo, custom servers, etc.)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ML Model API Keys
OPENAI_API_KEY=your_openai_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
DEBUG=true
LOG_LEVEL=INFO
WORKERS=4

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ML Pipeline
ML_BATCH_SIZE=32
ML_MAX_WORKERS=4
EMBEDDING_MODEL=all-MiniLM-L6-v2
SUMMARIZATION_MODEL=facebook/bart-large-cnn

# Feature Flags
ENABLE_PHISHING_DETECTION=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_RELATIONSHIP_GRAPH=true
ENABLE_TOPIC_MODELING=true
