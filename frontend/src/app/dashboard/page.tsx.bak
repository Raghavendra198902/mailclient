'use client';

import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Mail, Star, Send, Archive, Trash2, Inbox, RefreshCw, Search, Plus, LogOut, Sparkles, Clock, AlertCircle, CheckCircle, Filter, SortAsc, X } from 'lucide-react';
import ComposeModal from '@/components/ComposeModal';
import SmartReplyModal from '@/components/SmartReplyModal';

interface Message {
  id: string;
  subject: string;
  from_email: string;
  snippet: string;
  received_date: string;
  is_read: boolean;
  labels?: string[];
  body_html?: string;
  body_text?: string;
  ml_data?: {
    summary?: string;
    priority_score?: number;
    sentiment?: string;
    intent?: string;
  };
}

interface AIInsight {
  type: 'summary' | 'priority' | 'action' | 'sentiment';
  content: string;
  icon: any;
  color: string;
}

export default function Dashboard() {
  const [messages, setMessages] = useState<Message[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedMessage, setSelectedMessage] = useState<Message | null>(null);
  const [currentFolder, setCurrentFolder] = useState('inbox');
  const [searchQuery, setSearchQuery] = useState('');
  const [isSearching, setIsSearching] = useState(false);
  const [showAdvancedSearch, setShowAdvancedSearch] = useState(false);
  const [searchFilters, setSearchFilters] = useState({
    from_email: '',
    is_unread: false,
    date_from: '',
    date_to: ''
  });
  const [isComposeOpen, setIsComposeOpen] = useState(false);
  const [isSmartReplyOpen, setIsSmartReplyOpen] = useState(false);
  const [syncing, setSyncing] = useState(false);
  const [showFilters, setShowFilters] = useState(false);
  const [sortBy, setSortBy] = useState<'date' | 'sender' | 'subject'>('date');
  const [sortOrder, setSortOrder] = useState<'asc' | 'desc'>('desc');
  const [filterUnread, setFilterUnread] = useState(false);
  const [filterStarred, setFilterStarred] = useState(false);
  const [filterLabels, setFilterLabels] = useState<string[]>([]);
  const [lastSync, setLastSync] = useState<Date | null>(null);
  const [newEmailsCount, setNewEmailsCount] = useState(0);

  const fetchMessages = async () => {
    try {
      setLoading(true);
      const token = localStorage.getItem('access_token');
      
      if (!token) {
        window.location.href = '/connect';
        return;
      }

      const response = await fetch('http://localhost:8003/api/v1/messages/', {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (response.ok) {
        const data = await response.json();
        setMessages(data.messages || []);
      } else if (response.status === 401) {
        localStorage.removeItem('access_token');
        window.location.href = '/connect';
      }
    } catch (error) {
      console.error('Failed to fetch messages:', error);
    } finally {
      setLoading(false);
    }
  };

  const handleSync = async (silent: boolean = false) => {
    if (!silent) setSyncing(true);
    try {
      const previousCount = messages.length;
      const token = localStorage.getItem('access_token');
      const response = await fetch('http://localhost:8003/api/v1/messages/sync', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });

      if (response.ok) {
        await fetchMessages();
        setLastSync(new Date());
        
        // Check for new emails
        const newCount = messages.length - previousCount;
        if (newCount > 0 && silent) {
          setNewEmailsCount(newCount);
          setTimeout(() => setNewEmailsCount(0), 5000); // Clear after 5 seconds
        }
      }
    } catch (error) {
      if (!silent) console.error('Sync failed:', error);
    } finally {
      if (!silent) setSyncing(false);
    }
  };

  useEffect(() => {
    fetchMessages();
    
    // Auto-sync every 2 minutes
    const syncInterval = setInterval(() => {
      handleSync(true); // Silent sync
    }, 120000); // 2 minutes
    
    return () => clearInterval(syncInterval);
  }, []);

  // Keyboard shortcuts
  useEffect(() => {
    const handleKeyPress = (e: KeyboardEvent) => {
      // Ctrl/Cmd + R: Refresh
      if ((e.ctrlKey || e.metaKey) && e.key === 'r') {
        e.preventDefault();
        handleSync();
      }
      // C: Compose
      if (e.key === 'c' && !e.ctrlKey && !e.metaKey && document.activeElement?.tagName !== 'INPUT') {
        setIsComposeOpen(true);
      }
      // R: Reply (when message selected)
      if (e.key === 'r' && selectedMessage && !e.ctrlKey && !e.metaKey && document.activeElement?.tagName !== 'INPUT') {
        setIsSmartReplyOpen(true);
      }
      // Escape: Close modals
      if (e.key === 'Escape') {
        setIsComposeOpen(false);
        setIsSmartReplyOpen(false);
        setShowFilters(false);
      }
    };

    window.addEventListener('keydown', handleKeyPress);
    return () => window.removeEventListener('keydown', handleKeyPress);
  }, [selectedMessage]);

  const handleLogout = () => {
    localStorage.removeItem('access_token');
    window.location.href = '/';
  };

  const handleSearch = async () => {
    if (!searchQuery.trim()) {
      await fetchMessages();
      return;
    }

    setIsSearching(true);
    try {
      const token = localStorage.getItem('access_token');
      const response = await fetch('http://localhost:8003/api/v1/messages/search', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          query: searchQuery,
          folder: currentFolder === 'inbox' ? 'inbox' : null,
          from_email: searchFilters.from_email || null,
          is_unread: searchFilters.is_unread || null,
          date_from: searchFilters.date_from || null,
          date_to: searchFilters.date_to || null,
          limit: 50
        })
      });

      if (response.ok) {
        const data = await response.json();
        setMessages(data.messages || []);
      }
    } catch (error) {
      console.error('Search failed:', error);
    } finally {
      setIsSearching(false);
    }
  };

  const getFilteredAndSortedMessages = () => {
    let filtered = [...messages];

    // Apply filters
    if (filterUnread) {
      filtered = filtered.filter(m => !m.is_read);
    }
    if (filterStarred) {
      filtered = filtered.filter(m => m.labels?.includes('STARRED'));
    }
    if (filterLabels.length > 0) {
      filtered = filtered.filter(m => 
        filterLabels.some(label => m.labels?.includes(label))
      );
    }

    // Apply sorting
    filtered.sort((a, b) => {
      let comparison = 0;
      
      switch (sortBy) {
        case 'date':
          comparison = new Date(a.received_date).getTime() - new Date(b.received_date).getTime();
          break;
        case 'sender':
          comparison = a.from_email.localeCompare(b.from_email);
          break;
        case 'subject':
          comparison = a.subject.localeCompare(b.subject);
          break;
      }
      
      return sortOrder === 'asc' ? comparison : -comparison;
    });

    return filtered;
  };

  const handleSendEmail = async (to: string, subject: string, body: string) => {
    const token = localStorage.getItem('access_token');
    const response = await fetch('http://localhost:8003/api/v1/messages/send', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        to_email: to,
        subject,
        body
      })
    });

    if (!response.ok) {
      throw new Error('Failed to send email');
    }
  };

  const handleMessageAction = async (messageId: string, action: 'star' | 'archive' | 'delete') => {
    const token = localStorage.getItem('access_token');
    
    if (action === 'delete') {
      await fetch(`http://localhost:8003/api/v1/messages/${messageId}`, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });
    } else {
      const labels = selectedMessage?.labels || [];
      let newLabels = [...labels];
      
      if (action === 'star') {
        newLabels = labels.includes('STARRED') 
          ? labels.filter(l => l !== 'STARRED')
          : [...labels, 'STARRED'];
      } else if (action === 'archive') {
        newLabels = labels.filter(l => l !== 'INBOX');
        if (!newLabels.includes('ARCHIVED')) {
          newLabels.push('ARCHIVED');
        }
      }
      
      await fetch(`http://localhost:8003/api/v1/messages/${messageId}`, {
        method: 'PATCH',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ labels: newLabels })
      });
    }
    
    await fetchMessages();
  };

  const getAIInsights = (message: Message): AIInsight[] => {
    const insights: AIInsight[] = [];
    
    if (message.ml_data?.summary) {
      insights.push({
        type: 'summary',
        content: message.ml_data.summary,
        icon: Sparkles,
        color: 'text-purple-400'
      });
    }
    
    if (message.ml_data?.priority_score && message.ml_data.priority_score > 0.7) {
      insights.push({
        type: 'priority',
        content: 'High Priority',
        icon: AlertCircle,
        color: 'text-red-400'
      });
    }
    
    if (message.ml_data?.intent) {
      insights.push({
        type: 'action',
        content: `Intent: ${message.ml_data.intent}`,
        icon: CheckCircle,
        color: 'text-green-400'
      });
    }
    
    return insights;
  };

  const highPriorityCount = messages.filter(m => (m.ml_data?.priority_score || 0) > 0.7).length;
  const actionRequiredCount = messages.filter(m => m.ml_data?.intent === 'request').length;
  const unreadCount = messages.filter(m => !m.is_read).length;
  
  const folders = [
    { id: 'inbox', name: 'Inbox', icon: Inbox, count: messages.length },
    { id: 'starred', name: 'Starred', icon: Star, count: messages.filter(m => m.labels?.includes('STARRED')).length },
    { id: 'sent', name: 'Sent', icon: Send, count: messages.filter(m => m.labels?.includes('SENT')).length },
    { id: 'archive', name: 'Archive', icon: Archive, count: messages.filter(m => m.labels?.includes('ARCHIVED')).length },
    { id: 'trash', name: 'Trash', icon: Trash2, count: messages.filter(m => m.labels?.includes('TRASH')).length }
  ];

  const displayMessages = getFilteredAndSortedMessages();

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
      {/* Top Navigation */}
      {/* Modern Header with Gradient */}
      <div className="sticky top-0 z-50 bg-gradient-to-r from-slate-900 via-purple-900/20 to-slate-900 backdrop-blur-xl border-b border-purple-500/30 shadow-2xl">
        <div className="container mx-auto px-6 py-5">
          <div className="flex items-center justify-between">
            {/* Logo & Title */}
            <div className="flex items-center gap-4">
              <div className="relative">
                <div className="absolute inset-0 bg-gradient-to-r from-purple-600 to-pink-600 rounded-xl blur-xl opacity-50"></div>
                <div className="relative bg-gradient-to-br from-purple-600 to-pink-600 p-3 rounded-xl shadow-lg">
                  <Mail className="w-6 h-6 text-white" />
                </div>
              </div>
              <div>
                <h1 className="text-2xl font-bold bg-gradient-to-r from-white via-purple-200 to-pink-200 bg-clip-text text-transparent">
                  Email AI Manager
                </h1>
                <p className="text-xs text-slate-400 mt-0.5">Smart inbox powered by AI</p>
              </div>
            </div>
            
            {/* Search Bar */}
            <div className="flex-1 max-w-2xl mx-8">
              <div className="relative flex items-center gap-2">
                <div className="relative flex-1">
                  <Search className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" />
                  <input
                    type="text"
                    placeholder="Search emails, contacts, or content..."
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    onKeyPress={(e) => e.key === 'Enter' && handleSearch()}
                    className="w-full pl-12 pr-4 py-3 bg-slate-800/60 border border-slate-700/50 rounded-xl text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-purple-500/50 focus:border-purple-500/50 transition-all"
                  />
                </div>
                {searchQuery ? (
                  <button
                    onClick={() => { setSearchQuery(''); fetchMessages(); }}
                    className="px-4 py-3 bg-slate-700/50 hover:bg-slate-700 text-slate-300 rounded-xl transition-all font-medium"
                  >
                    Clear
                  </button>
                ) : (
                  <button
                    onClick={handleSearch}
                    disabled={isSearching}
                    className="px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white rounded-xl transition-all disabled:opacity-50 font-medium shadow-lg hover:shadow-purple-500/50"
                  >
                    {isSearching ? 'Searching...' : 'Search'}
                  </button>
                )}
              </div>
            </div>

            {/* Action Buttons */}
            <div className="flex items-center gap-3">
              {/* Sync Button with Badge */}
              <button
                onClick={() => handleSync()}
                disabled={syncing}
                className="relative p-3 bg-slate-800/60 hover:bg-slate-700/80 rounded-xl transition-all disabled:opacity-50 group"
                title={lastSync ? `Last synced: ${lastSync.toLocaleTimeString()}` : 'Sync emails'}
              >
                <RefreshCw className={`w-5 h-5 text-slate-300 group-hover:text-white transition-colors ${syncing ? 'animate-spin' : ''}`} />
                {newEmailsCount > 0 && (
                  <motion.span
                    initial={{ scale: 0 }}
                    animate={{ scale: 1 }}
                    className="absolute -top-1 -right-1 bg-gradient-to-r from-green-500 to-emerald-500 text-white text-xs rounded-full w-6 h-6 flex items-center justify-center font-bold shadow-lg"
                  >
                    {newEmailsCount}
                  </motion.span>
                )}
              </button>
              
              {/* Last Sync Time */}
              {lastSync && (
                <div className="hidden lg:flex flex-col items-end">
                  <span className="text-xs text-slate-400">Last sync</span>
                  <span className="text-xs text-slate-300 font-medium">{lastSync.toLocaleTimeString()}</span>
                </div>
              )}
              
              {/* Logout Button */}
              <button
                onClick={handleLogout}
                className="flex items-center gap-2 px-4 py-3 bg-slate-800/60 hover:bg-red-600/20 border border-slate-700/50 hover:border-red-500/50 rounded-xl transition-all text-slate-300 hover:text-red-400 group"
              >
                <LogOut className="w-5 h-5 transition-transform group-hover:translate-x-0.5" />
                <span className="font-medium">Logout</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      {/* Stats Bar */}
      <div className="bg-slate-800/30 border-b border-slate-700/50">
        <div className="container mx-auto px-6 py-3">
          <div className="flex items-center justify-between text-sm">
            <div className="flex items-center gap-6">
              <div className="flex items-center gap-2">
                <div className="w-2 h-2 bg-purple-500 rounded-full animate-pulse"></div>
                <span className="text-slate-400">
                  <span className="text-white font-semibold">{messages.length}</span> Total
                </span>
              </div>
              <div className="flex items-center gap-2">
                <div className="w-2 h-2 bg-blue-500 rounded-full"></div>
                <span className="text-slate-400">
                  <span className="text-blue-400 font-semibold">{unreadCount}</span> Unread
                </span>
              </div>
              <div className="flex items-center gap-2">
                <div className="w-2 h-2 bg-yellow-500 rounded-full"></div>
                <span className="text-slate-400">
                  <span className="text-yellow-400 font-semibold">{highPriorityCount}</span> Priority
                </span>
              </div>
            </div>
            <div className="text-slate-500 text-xs">
              Auto-sync enabled • Updates every 2 minutes
            </div>
          </div>
        </div>
      </div>

      <div className="container mx-auto px-6 py-6">
        <div className="grid grid-cols-12 gap-5">
          {/* Modern Sidebar */}
          <motion.div
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            className="col-span-3 space-y-4"
          >
            {/* Compose Button */}
            <button 
              onClick={() => setIsComposeOpen(true)}
              className="w-full group relative overflow-hidden px-6 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-2xl font-semibold hover:shadow-2xl hover:shadow-purple-500/50 transition-all duration-300 flex items-center justify-center gap-2"
            >
              <div className="absolute inset-0 bg-gradient-to-r from-pink-600 to-purple-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <Plus className="w-5 h-5 relative z-10" />
              <span className="relative z-10">Compose</span>
            </button>

            {/* Folders */}
            <div className="bg-slate-800/40 backdrop-blur-xl border border-slate-700/50 rounded-2xl p-4 shadow-xl">
              <div className="space-y-1">
                {folders.map((folder) => {
                  const Icon = folder.icon;
                  return (
                    <button
                      key={folder.id}
                      onClick={() => setCurrentFolder(folder.id)}
                      className={`w-full group flex items-center justify-between px-4 py-3.5 rounded-xl transition-all duration-200 ${
                        currentFolder === folder.id
                          ? 'bg-gradient-to-r from-purple-600/20 to-pink-600/20 text-white shadow-lg border border-purple-500/30'
                          : 'text-slate-400 hover:bg-slate-700/30 hover:text-white'
                      }`}
                    >
                      <div className="flex items-center gap-3">
                        <Icon className={`w-5 h-5 transition-transform group-hover:scale-110 ${
                          currentFolder === folder.id ? 'text-purple-400' : ''
                        }`} />
                        <span className="font-medium">{folder.name}</span>
                      </div>
                      {folder.count > 0 && (
                        <span className={`text-xs px-2.5 py-1 rounded-full font-semibold ${
                          currentFolder === folder.id
                            ? 'bg-purple-500/30 text-purple-200'
                            : 'bg-slate-700 text-slate-300'
                        }`}>
                          {folder.count}
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>
            </div>

            {/* AI Insights Card */}
            <div className="bg-gradient-to-br from-slate-800/60 to-purple-900/20 backdrop-blur-xl border border-purple-500/30 rounded-2xl p-5 shadow-xl">
              <div className="flex items-center gap-2 mb-4">
                <div className="p-2 bg-purple-500/20 rounded-lg">
                  <Sparkles className="w-5 h-5 text-purple-400" />
                </div>
                <span className="font-semibold text-white">AI Insights</span>
              </div>
              <div className="space-y-3">
                <div className="flex items-center justify-between p-3 bg-slate-800/40 rounded-xl">
                  <span className="text-slate-400 text-sm">Processed</span>
                  <span className="font-bold text-white text-lg">{messages.length}</span>
                </div>
                <div className="flex items-center justify-between p-3 bg-red-500/10 rounded-xl border border-red-500/20">
                  <span className="text-red-300 text-sm">High Priority</span>
                  <span className="font-bold text-red-400 text-lg">{highPriorityCount}</span>
                </div>
                <div className="flex items-center justify-between p-3 bg-yellow-500/10 rounded-xl border border-yellow-500/20">
                  <span className="text-yellow-300 text-sm">Action Required</span>
                  <span className="font-bold text-yellow-400 text-lg">{actionRequiredCount}</span>
                </div>
              </div>
            </div>
          </motion.div>

          {/* Modern Message List */}
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="col-span-5"
          >
            <div className="bg-slate-800/40 backdrop-blur-xl border border-slate-700/50 rounded-2xl overflow-hidden shadow-xl">
              {/* Header */}
              <div className="p-5 border-b border-slate-700/50 bg-slate-800/60">
                <div className="flex items-center justify-between">
                  <div>
                    <h2 className="text-xl font-bold text-white">
                      {folders.find(f => f.id === currentFolder)?.name}
                    </h2>
                    <p className="text-sm text-slate-400 mt-0.5">
                      {displayMessages.length} {displayMessages.length === 1 ? 'message' : 'messages'}
                    </p>
                  </div>
                  
                  <div className="flex items-center gap-2">
                    {/* Filter Button */}
                    <button
                      onClick={() => setShowFilters(!showFilters)}
                      className={`flex items-center gap-2 px-4 py-2.5 rounded-xl transition-all ${
                          showFilters || filterUnread || filterStarred 
                            ? 'bg-purple-600 text-white' 
                            : 'bg-slate-700/50 hover:bg-slate-700 text-slate-300'
                        }`}
                      >
                        <Filter className="w-4 h-4" />
                        <span className="text-sm">Filters</span>
                      </button>
                    </div>

                    {/* Sort Controls */}
                    <select
                      value={sortBy}
                      onChange={(e) => setSortBy(e.target.value as 'date' | 'sender' | 'subject')}
                      className="px-3 py-2 bg-slate-700/50 border border-slate-600 rounded-lg text-white text-sm focus:outline-none focus:border-purple-500"
                    >
                      <option value="date">Date</option>
                      <option value="sender">Sender</option>
                      <option value="subject">Subject</option>
                    </select>

                    <button
                      onClick={() => setSortOrder(sortOrder === 'asc' ? 'desc' : 'asc')}
                      className="p-2 bg-slate-700/50 hover:bg-slate-700 rounded-lg transition-colors"
                      title={sortOrder === 'asc' ? 'Ascending' : 'Descending'}
                    >
                      <SortAsc className={`w-4 h-4 text-slate-300 transition-transform ${sortOrder === 'desc' ? 'rotate-180' : ''}`} />
                    </button>
                  </div>
                </div>

                {/* Filter Panel */}
                <AnimatePresence>
                  {showFilters && (
                    <motion.div
                      initial={{ height: 0, opacity: 0 }}
                      animate={{ height: 'auto', opacity: 1 }}
                      exit={{ height: 0, opacity: 0 }}
                      className="mt-4 pt-4 border-t border-slate-700/50 overflow-hidden"
                    >
                      <div className="flex items-center gap-4 flex-wrap">
                        <button
                          onClick={() => setFilterUnread(!filterUnread)}
                          className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm transition-colors ${
                            filterUnread 
                              ? 'bg-purple-600 text-white' 
                              : 'bg-slate-700/50 hover:bg-slate-700 text-slate-300'
                          }`}
                        >
                          <Mail className="w-4 h-4" />
                          <span>Unread Only</span>
                        </button>

                        <button
                          onClick={() => setFilterStarred(!filterStarred)}
                          className={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm transition-colors ${
                            filterStarred 
                              ? 'bg-purple-600 text-white' 
                              : 'bg-slate-700/50 hover:bg-slate-700 text-slate-300'
                          }`}
                        >
                          <Star className="w-4 h-4" />
                          <span>Starred Only</span>
                        </button>

                        {(filterUnread || filterStarred) && (
                          <button
                            onClick={() => { setFilterUnread(false); setFilterStarred(false); }}
                            className="flex items-center gap-1 px-3 py-1.5 bg-red-500/20 hover:bg-red-500/30 text-red-300 rounded-lg text-sm transition-colors"
                          >
                            <X className="w-4 h-4" />
                            <span>Clear Filters</span>
                          </button>
                        )}

                        <div className="text-xs text-slate-400 ml-auto">
                          Showing {displayMessages.length} of {messages.length} messages
                        </div>
                      </div>
                    </motion.div>
                  )}
                </AnimatePresence>
              </div>

              <div className="divide-y divide-slate-700/50 max-h-[calc(100vh-250px)] overflow-y-auto">
                {loading ? (
                  <div className="p-12 text-center text-slate-400">
                    <RefreshCw className="w-8 h-8 animate-spin mx-auto mb-4" />
                    <p>Loading messages...</p>
                  </div>
                ) : displayMessages.length === 0 ? (
                  <div className="p-12 text-center text-slate-400">
                    <Mail className="w-12 h-12 mx-auto mb-4 opacity-50" />
                    <p>No messages found</p>
                  </div>
                ) : (
                  displayMessages.map((message, index) => (
                    <motion.button
                      key={message.id}
                      initial={{ opacity: 0, y: 10 }}
                      animate={{ opacity: 1, y: 0 }}
                      transition={{ delay: index * 0.05 }}
                      onClick={() => setSelectedMessage(message)}
                      className={`w-full p-4 text-left hover:bg-slate-700/30 transition-colors ${
                        selectedMessage?.id === message.id ? 'bg-purple-900/20' : ''
                      } ${!message.is_read ? 'bg-slate-700/20' : ''}`}
                    >
                      <div className="flex items-start justify-between mb-2">
                        <div className="flex-1 min-w-0">
                          <p className={`font-semibold truncate ${
                            !message.is_read ? 'text-white' : 'text-slate-300'
                          }`}>
                            {message.from_email}
                          </p>
                          <p className={`text-sm truncate ${
                            !message.is_read ? 'text-purple-300' : 'text-slate-400'
                          }`}>
                            {message.subject}
                          </p>
                        </div>
                        <div className="flex items-center gap-2 ml-4">
                          {message.ml_data?.priority_score && message.ml_data.priority_score > 0.7 && (
                            <AlertCircle className="w-4 h-4 text-red-400" />
                          )}
                          <Clock className="w-4 h-4 text-slate-500" />
                        </div>
                      </div>
                      <p className="text-sm text-slate-400 truncate">
                        {message.snippet}
                      </p>
                      {message.ml_data?.summary && (
                        <div className="mt-2 flex items-center gap-2 text-xs text-purple-400">
                          <Sparkles className="w-3 h-3" />
                          <span className="truncate">{message.ml_data.summary}</span>
                        </div>
                      )}
                    </motion.button>
                  ))
                )}
              </div>
            </div>
          </motion.div>

          {/* Message Detail */}
          <motion.div
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            className="col-span-4"
          >
            {selectedMessage ? (
              <div className="bg-slate-800/50 backdrop-blur-xl border border-purple-500/20 rounded-xl overflow-hidden">
                <div className="p-6 border-b border-slate-700/50">
                  <div className="flex items-start justify-between mb-4">
                    <div className="flex-1">
                      <h3 className="text-xl font-semibold text-white mb-2">
                        {selectedMessage.subject}
                      </h3>
                      <p className="text-slate-400">{selectedMessage.from_email}</p>
                    </div>
                    <div className="flex gap-2">
                      <button 
                        onClick={() => handleMessageAction(selectedMessage.id, 'star')}
                        className="p-2 hover:bg-slate-700/50 rounded-lg transition-colors"
                      >
                        <Star className={`w-5 h-5 ${selectedMessage.labels?.includes('STARRED') ? 'text-yellow-400 fill-yellow-400' : 'text-slate-400'}`} />
                      </button>
                      <button 
                        onClick={() => handleMessageAction(selectedMessage.id, 'archive')}
                        className="p-2 hover:bg-slate-700/50 rounded-lg transition-colors"
                      >
                        <Archive className="w-5 h-5 text-slate-400" />
                      </button>
                      <button 
                        onClick={() => handleMessageAction(selectedMessage.id, 'delete')}
                        className="p-2 hover:bg-slate-700/50 rounded-lg transition-colors"
                      >
                        <Trash2 className="w-5 h-5 text-slate-400" />
                      </button>
                    </div>
                  </div>
                  
                  <p className="text-sm text-slate-500">
                    {new Date(selectedMessage.received_date).toLocaleString()}
                  </p>
                </div>

                {/* AI Insights */}
                {getAIInsights(selectedMessage).length > 0 && (
                  <div className="p-6 bg-gradient-to-br from-purple-900/20 to-pink-900/20 border-b border-slate-700/50">
                    <div className="flex items-center gap-2 mb-4">
                      <Sparkles className="w-5 h-5 text-purple-400" />
                      <span className="text-sm font-semibold text-purple-300">AI Insights</span>
                    </div>
                    <div className="space-y-3">
                      {getAIInsights(selectedMessage).map((insight, index) => {
                        const Icon = insight.icon;
                        return (
                          <div key={index} className="flex items-start gap-3">
                            <Icon className={`w-4 h-4 mt-1 ${insight.color}`} />
                            <p className="text-sm text-slate-300">{insight.content}</p>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                )}

                <div className="p-6 max-h-[calc(100vh-450px)] overflow-y-auto">
                  <div className="prose prose-invert max-w-none">
                    {selectedMessage.body_html ? (
                      <div 
                        className="text-slate-300"
                        dangerouslySetInnerHTML={{ __html: selectedMessage.body_html }}
                      />
                    ) : (
                      <p className="text-slate-300 whitespace-pre-wrap">
                        {selectedMessage.body_text || selectedMessage.snippet}
                      </p>
                    )}
                  </div>
                </div>

                <div className="p-6 border-t border-slate-700/50 space-y-3">
                  <button 
                    onClick={() => setIsSmartReplyOpen(true)}
                    className="w-full px-4 py-3 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700 text-white rounded-lg font-semibold transition-all shadow-lg hover:shadow-xl flex items-center justify-center gap-2"
                  >
                    <Sparkles className="w-5 h-5" />
                    Smart Reply
                  </button>
                  <button className="w-full px-4 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-semibold transition-colors">
                    Reply
                  </button>
                  <button className="w-full px-4 py-3 bg-slate-700/50 hover:bg-slate-700 text-slate-300 rounded-lg font-semibold transition-colors">
                    Forward
                  </button>
                </div>
              </div>
            ) : (
              <div className="bg-slate-800/50 backdrop-blur-xl border border-purple-500/20 rounded-xl p-12 text-center">
                <Mail className="w-16 h-16 text-slate-600 mx-auto mb-4" />
                <p className="text-slate-400">Select a message to view details</p>
              </div>
            )}
          </motion.div>
        </div>
      </div>

      {/* Compose Modal */}
      <ComposeModal
        isOpen={isComposeOpen}
        onClose={() => setIsComposeOpen(false)}
        onSend={handleSendEmail}
      />

      {/* Smart Reply Modal */}
      {selectedMessage && (
        <SmartReplyModal
          isOpen={isSmartReplyOpen}
          onClose={() => setIsSmartReplyOpen(false)}
          onSend={handleSendEmail}
          messageId={selectedMessage.id}
          originalFrom={selectedMessage.from_email}
          originalSubject={selectedMessage.subject}
        />
      )}
    </div>
  );
}
